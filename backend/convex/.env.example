# Backend Convex environment configuration.
# Values with no EXPO_PUBLIC_ prefix must never ship to the mobile app bundle.
# Set live values with:
#   npx convex env set EBAY_CLIENT_ID your_key_here

# --- Convex deployment (managed by `npx convex dev`) ---
# CONVEX_DEPLOYMENT=
# CONVEX_URL=
# CONVEX_SITE_URL=

# --- Pricing providers (per docs/PRICING_SOURCES.md) ---

# Reverb public listings spike
# No credential currently required for the backend-only read path.
# If Reverb upgrades this to registered-app access later, add the token here.
# REVERB_API_TOKEN=

# eBay Browse API (eBay developer account required)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# PriceCharting API token
PRICECHARTING_API_TOKEN=

# Amazon Product Advertising API (Associates account required, scaffolded only)
AMAZON_PA_API_ACCESS_KEY=
AMAZON_PA_API_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Brave Web Search (now discovery-only, returns no structured prices)
BRAVE_SEARCH_API_KEY=

# --- Provider feature flags ---
# Comma-separated provider names to skip: reverb, ebay, pricecharting, brave.
# Takes effect immediately after `npx convex env set`; no deploy needed.
# PRICING_DISABLED_PROVIDERS=ebay

# --- Pricing abuse limits (fresh lookups only; cache hits are not counted) ---
# Until lookups require an account and spend credits, these bound API spend.
# PRICING_DEVICE_HOURLY_LIMIT=20
# PRICING_DEVICE_DAILY_LIMIT=60
# PRICING_GLOBAL_DAILY_LIMIT=1000
