{
  "name": "pricernu",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first object intelligence app for identifying, valuing, and cataloging real-world items.",
  "workspaces": [
    "apps/*",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-expo-gemini-nano.cjs",
    "start": "npm run start --workspace @pricernu/mobile",
    "start:dev": "npm run start:dev --workspace @pricernu/mobile",
    "start:go": "npm run start:go --workspace @pricernu/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:storage": "npm run test:storage --workspace @pricernu/mobile"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "expo-modules-core": "57.0.24",
    "expo-modules-jsi": "57.1.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
