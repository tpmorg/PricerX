{
  "name": "@pricernu/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android:dev": "expo start --dev-client --android",
    "ios:dev": "expo start --dev-client --ios",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "serve:web": "node scripts/serve-web.cjs",
    "build:dev:android": "npx eas build --platform android --profile development",
    "build:dev:ios": "npx eas build --platform ios --profile development",
    "build:preview:android": "npx eas build --platform android --profile preview",
    "build:preview:ios": "npx eas build --platform ios --profile preview",
    "build:prod:android": "npx eas build --platform android --profile production",
    "build:prod:ios": "npx eas build --platform ios --profile production",
    "env:create": "npx eas env:create",
    "env:list": "npx eas env:list",
    "env:list:development": "npx eas env:list --environment development",
    "env:list:preview": "npx eas env:list --environment preview",
    "env:list:production": "npx eas env:list --environment production",
    "env:pull:development": "npx eas env:pull --environment development",
    "env:pull:preview": "npx eas env:pull --environment preview",
    "env:pull:production": "npx eas env:pull --environment production",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:storage": "node scripts/test-storage.cjs"
  },
  "dependencies": {
    "@pricernu/shared": "0.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@sentry/react-native": "~7.11.0",
    "convex": "^1.42.0",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gemini-nano": "git+https://github.com/tpmorg/expo-gemini-nano-module.git",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.3.0",
    "lucide-react-native": "^1.23.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^9.9.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~57.0.0",
    "expo-build-properties": "~57.0.22",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
