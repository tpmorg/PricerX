{
  "name": "@pricernu/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android:dev": "expo start --dev-client --android",
    "ios:dev": "expo start --dev-client --ios",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev:android": "npx eas build --platform android --profile development",
    "env:create": "npx eas env:create",
    "env:list": "npx eas env:list",
    "env:list:development": "npx eas env:list --environment development",
    "env:list:preview": "npx eas env:list --environment preview",
    "env:list:production": "npx eas env:list --environment production",
    "env:pull:development": "npx eas env:pull --environment development",
    "env:pull:preview": "npx eas env:pull --environment preview",
    "env:pull:production": "npx eas env:pull --environment production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pricernu/shared": "0.0.0",
    "convex": "^1.42.0",
    "expo": "^57.0.27",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-gemini-nano": "git+https://github.com/tpmorg/expo-gemini-nano-module.git",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.23.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "expo-build-properties": "~57.0.22",
    "typescript": "~6.0.3"
  }
}
