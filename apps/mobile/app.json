{
  "expo": {
    "name": "Pricernu",
    "slug": "pricernu",
    "scheme": "pricernu",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tpmorg.pricernu"
    },
    "android": {
      "package": "com.tpmorg.pricernu"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pricernu uses your photo library so you can price and catalog items from saved photos.",
          "cameraPermission": "Pricernu uses your camera so you can capture item photos for local pricing and storage."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0d21bdf-7948-44d0-ae8e-994de32b5895"
      }
    }
  }
}
