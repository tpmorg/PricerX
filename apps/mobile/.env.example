# Expo public client configuration.
# Values with EXPO_PUBLIC_ are bundled into the app JavaScript and must be safe
# for end users to inspect.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional reusable-framework adapters. Leave unset until the corresponding
# product service is intentionally enabled and configured.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=
EXPO_PUBLIC_REVENUECAT_CREDIT_CODE=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=false

# The imported framework includes Firebase adapters, but Pricernu has not
# selected or enabled them; Clerk remains the preferred identity direction.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Build-only Sentry identifiers; these are not EXPO_PUBLIC values.
SENTRY_ORG=
SENTRY_PROJECT=

# Backend-only secrets do not belong in the mobile app bundle.
# Set these on the Convex backend instead, for example:
#   npx convex env set EBAY_CLIENT_ID your_key_here
# Server-only keys (do NOT ship in mobile bundle):
#   REVERB_API_TOKEN=
#   EBAY_CLIENT_ID=
#   EBAY_CLIENT_SECRET=
#   PRICECHARTING_API_TOKEN=
#   AMAZON_PA_API_ACCESS_KEY=
#   AMAZON_PA_API_SECRET_KEY=
#   AMAZON_PARTNER_TAG=
#   BRAVE_SEARCH_API_KEY=
#   OPENAI_API_KEY=
#   STRIPE_SECRET_KEY=
# See docs/PRICING_SOURCES.md for the full provider matrix.
