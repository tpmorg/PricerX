# Expo public client configuration.
# Values with EXPO_PUBLIC_ are bundled into the app JavaScript and must be safe
# for end users to inspect.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend-only secrets do not belong in the mobile app bundle.
# Set these in the backend runtime instead, for example:
#   npx convex env set BRAVE_SEARCH_API_KEY your_key_here
# BRAVE_SEARCH_API_KEY=
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
